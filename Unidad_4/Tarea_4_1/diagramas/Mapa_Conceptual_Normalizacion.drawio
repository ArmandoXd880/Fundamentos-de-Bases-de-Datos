" /><Array as="points"><mxPoint x="1375" y="625" /><mxPoint x="1220" y="625" /></Array></mxGeometry></mxCell><mxCell id="n48" value="se evalúa en" style="text;html=0;fillColor=white;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=19;fontStyle=0;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="1210" y="590" width="134.96875" height="28.5" /></mxCell><mxCell id="n49" value="DF = dependencia funcional. DMV = dependencia multivaluada. Ejemplos del préstamo deportivo." style="text;html=0;fillColor=none;strokeColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=19;fontStyle=0;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="343.5234375" y="956" width="952.953125" height="28.5" /></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="Condiciones de las formas normales"><mxGraphModel dx="1640" dy="1030" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1030" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n2" value="Condiciones de las formas normales" style="text;html=0;fillColor=none;strokeColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=30;fontStyle=1;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="507.7421875" y="22" width="624.515625" height="45.0" /></mxCell><mxCell id="n3" value="" style="strokeColor=#17365d;fontFamily=DejaVu Sans;shape=rectangle;fillColor=#eaf2f8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="120" width="680" height="200" /></mxCell><mxCell id="n4" value="1FN  Valores atómicos" style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="78" y="132" width="290.09375" height="33.0" /></mxCell><mxCell id="n5" value="Un valor por atributo y tupla, según su dominio." style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=0;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="78" y="172" width="494.359375" height="30.0" /></mxCell><mxCell id="n6" value="Sin listas de piezas o teléfonos en una celda." style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=0;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="78" y="202" width="464.28125" height="30.0" /></mxCell><mxCell id="n7" value="Ejemplo: UsuarioTelefono(idUsuario, telefono)." style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=0;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="78" y="232" width="477.953125" height="30.0" /></mxCell><mxCell id="n8" value="" style="strokeColor=#17365d;fontFamily=DejaVu Sans;shape=rectangle;fillColor=#eaf2f8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="900" y="120" width="680" height="200" /></mxCell><mxCell id="n9" value="2FN  Dependencia completa" style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="918" y="132" width="361.65625" height="33.0" /></mxCell><mxCell id="n10" value="1FN y ningún atributo no primo depende de" style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=0;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="918" y="172" width="453.671875" height="30.0" /></mxCell><mxCell id="n11" value="una parte propia de alguna clave candidata." style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=0;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="918" y="202" width="458.0" height="30.0" /></mxCell><mxCell id="n12" value="Separa la cabecera de las líneas del préstamo." style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=0;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="918" y="232" width="482.46875" height="30.0" /></mxCell><mxCell id="n13" value="" style="strokeColor=#17365d;fontFamily=DejaVu Sans;shape=rectangle;fillColor=#eaf2f8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="900" y="430" width="680" height="200" /></mxCell><mxCell id="n14" value="3FN  Condición sobre cada DF" style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="918" y="442" width="384.09375" height="33.0" /></mxCell><mxCell id="n15" value="Para cada X → A no trivial: X es superclave" style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=0;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="918" y="482" width="441.265625" height="30.0" /></mxCell><mxCell id="n16" value="o A es primo. Evita las transitivas que la violan." style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=0;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="918" y="512" width="489.359375" height="30.0" /></mxCell><mxCell id="n17" value="Separa idTipo → nombreTipo, deporte." style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=0;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="918" y="542" width="397.359375" height="30.0" /></mxCell><mxCell id="n18" value="" style="strokeColor=#17365d;fontFamily=DejaVu Sans;shape=rectangle;fillColor=#eaf2f8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="430" width="680" height="200" /></mxCell><mxCell id="n19" value="FNBC  Determinantes superclave" style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="78" y="442" width="422.90625" height="33.0" /></mxCell><mxCell id="n20" value="Para toda DF no trivial X → Y, X es superclave." style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=0;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="78" y="482" width="475.875" height="30.0" /></mxCell><mxCell id="n21" value="Examina todas las claves y dependencias." style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=0;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="78" y="512" width="437.40625" height="30.0" /></mxCell><mxCell id="n22" value="Es más exigente que 3FN." style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=0;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="78" y="542" width="275.109375" height="30.0" /></mxCell><mxCell id="n23" value="" style="strokeColor=#17365d;fontFamily=DejaVu Sans;shape=rectangle;fillColor=#eaf2f8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="740" width="680" height="200" /></mxCell><mxCell id="n24" value="4FN  Independencia multivaluada" style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="78" y="752" width="430.34375" height="33.0" /></mxCell><mxCell id="n25" value="Para toda DMV no trivial X →→ Y," style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=0;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="78" y="792" width="341.34375" height="30.0" /></mxCell><mxCell id="n26" value="X debe ser superclave. Separa conjuntos" style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=0;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="78" y="822" width="423.453125" height="30.0" /></mxCell><mxCell id="n27" value="independientes como teléfonos y deportes." style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=0;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="78" y="852" width="448.75" height="30.0" /></mxCell><mxCell id="n28" value="" style="strokeColor=#17365d;fontFamily=DejaVu Sans;shape=rectangle;fillColor=#eaf2f8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="900" y="740" width="680" height="200" /></mxCell><mxCell id="n29" value="5FN  Dependencias de reunión" style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="918" y="752" width="393.8125" height="33.0" /></mxCell><mxCell id="n30" value="Toda dependencia de reunión no trivial" style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=0;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="918" y="792" width="403.6875" height="30.0" /></mxCell><mxCell id="n31" value="debe estar implicada por las claves candidatas." style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=0;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="918" y="822" width="491.109375" height="30.0" /></mxCell><mxCell id="n32" value="No descomponer una relación ternaria sin regla." style="text;html=0;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=0;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="918" y="852" width="497.234375" height="30.0" /></mxCell><mxCell id="n33" value="" style="strokeColor=#17365d;fontFamily=DejaVu Sans;endArrow=open;startArrow=none;strokeWidth=2;rounded=0;endFill=1;startFill=1;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n3" target="n8"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="740" y="220" /><mxPoint as="targetPoint" x="900" y="220" /></mxGeometry></mxCell><mxCell id="n34" value="añade" style="text;html=0;fillColor=white;strokeColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=19;fontStyle=0;fontColor=#17232e;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="783.4609375" y="183" width="73.078125" height="28.5" /></mxCell><mxCell id="n35" value="" style="strokeColor=#17365d;fontFamily=DejaVu Sans;endArrow=open;startArrow=none;strokeWidth=2;rounded=0;endF